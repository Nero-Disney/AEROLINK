    val cameraProfileId: String,
    val width: Int,
    val height: Int,
    val fx: Float,
    val fy: Float,
    val cx: Float,
    val cy: Float,
    val distortion: List<Float>,
    val horizontalFovDegrees: Float,
    val verticalFovDegrees: Float,
    val calibratedAt: Long,
    val reprojectionError: Float
)
```

